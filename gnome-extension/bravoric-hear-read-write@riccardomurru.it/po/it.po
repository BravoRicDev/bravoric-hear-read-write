msgstr "Stream — Testo consegnato"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:161
msgid "General — Error"
msgstr "Generale — Errore"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:222
msgid "Sequential: one level at a time, in order."
msgstr "Sequenziale: un livello alla volta, in ordine."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:224
#, javascript-format
msgid "Ignored in sequential mode: %s"
msgstr "Ignorati in modalità sequenziale: %s"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:232
msgid "Sequential (no level marked parallel)."
msgstr "Sequenziale (nessun livello segnato come parallelo)."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:240
#, javascript-format
msgid "Parallel: %d endpoints in the pool, up to %d workers."
msgstr "Parallelo: %d endpoint nel pool, fino a %d worker."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:245
msgid ""
"The worker cap is automatic: it is recalculated at each session from the "
"endpoints not in cooldown, so the real number can be lower."
msgstr "Il limite di worker è automatico: viene ricalcolato a ogni sessione sugli endpoint non in cooldown, quindi il numero reale può essere inferiore."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:249
#, javascript-format
msgid "Not in the pool, unreachable while another level is parallel: %s"
msgstr "Fuori dal pool, irraggiungibili finché un altro livello è parallelo: %s"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:259
msgid ""
"Ignored: the global Dispatch mode is Sequential. This level takes no part in "
"the parallel pool."
msgstr "Ignorato: la Modalità di dispatch globale è Sequenziale. Questo livello non partecipa al pool parallelo."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:260
msgid ""
"Send chunks to this endpoint at the same time as the other levels marked "
"parallel, up to the slot limit below. Levels not marked here are NOT used as "
"fallback."
msgstr "Invia i chunk a questo endpoint contemporaneamente agli altri livelli segnati come paralleli, fino al limite di slot qui sotto. I livelli non segnati NON sono usati come ripiego."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:328
msgid "STT notifications (voice dictation)"
msgstr "Notifiche STT (dettatura vocale)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:330
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:342
msgid "Processing started"
msgstr "Elaborazione avviata"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:331
msgid "Notify when transcription starts (no text available at this point)"
msgstr ""
"Notifica all'avvio della trascrizione (a questo punto nessun testo "
"disponibile)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:334
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:346
msgid "Raw text ready"
msgstr "Testo grezzo pronto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:334
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:346
msgid "Notify when the raw text is in the clipboard"
msgstr "Notifica quando il testo grezzo è negli appunti"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:335
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:347
msgid "Cleaned text ready"
msgstr "Testo pulito pronto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:335
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:347
msgid "Notify when the LLM-corrected text is in the clipboard"
msgstr "Notifica quando il testo corretto dall'LLM è negli appunti"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:340
msgid "OCR notifications (screenshot)"
msgstr "Notifiche OCR (screenshot)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:343
msgid "Notify when extraction starts (no text available at this point)"
msgstr ""
"Notifica all'avvio dell'estrazione (a questo punto nessun testo disponibile)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:352
msgid "Streaming notifications"
msgstr "Notifiche streaming"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:354
msgid "Streaming session started"
msgstr "Sessione streaming avviata"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:355
msgid "Notify when streaming dictation starts"
msgstr "Notifica quando inizia la dettatura streaming"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:358
msgid "Transcribed text ready"
msgstr "Testo trascritto pronto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:358
msgid "Notify when streamed text is ready"
msgstr "Notifica quando il testo streaming è pronto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:447
msgid "Notifications"
msgstr "Notifiche"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:480
msgid "Show content in notification text"
msgstr "Mostra il contenuto nel testo della notifica"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:481
msgid "If off, shows only the title (no transcribed text)"
msgstr "Se disattivato, mostra solo il titolo (nessun testo trascritto)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:514
msgid "Shortcuts"
msgstr "Scorciatoie"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:520
msgid "Global keyboard shortcuts"
msgstr "Scorciatoie da tastiera globali"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:521
msgid ""
"Format: <Alt><Super>r (modifier names between angle brackets, then the key)"
msgstr ""
"Formato: <Alt><Super>r (nomi dei modificatori tra parentesi angolari, poi il "
"tasto)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:551
#, javascript-format
msgid "Already used by: %s"
msgstr "Già usata da: %s"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:592
#, javascript-format
msgid "Not a valid shortcut: %s"
msgstr "Non è una scorciatoia valida: %s"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:570
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/extension.js:188
msgid "Streaming"
msgstr "Streaming"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:584
msgid "Streaming dictation (experimental)"
msgstr "Dettatura in streaming (sperimentale)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:585
msgid ""
"Direct typing into the focused field. \"At end\": single recording "
"transcribed when stopped. \"Per chunk\": continuous segmentation on pauses."
msgstr ""
"Scrittura diretta nel campo attivo. \"Alla fine\": registrazione unica "
"trascritta allo stop. \"Per chunk\": segmentazione continua sulle pause."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:590
msgid "Mode"
msgstr "Modalità"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:592
msgid "Per chunk (transcribe on pauses)"
msgstr "Per chunk (trascrive sulle pause)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:592
msgid "At end (transcribe when stopped)"
msgstr "Alla fine (trascrive quando fermo)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:613
msgid "Dispatch mode (per-chunk mode only)"
msgstr "Modalità di dispatch (solo per modalità per-chunk)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:614
msgid ""
"Auto uses the pool of endpoints marked parallel; sequential ignores every "
"per-level switch and walks the levels in order. Not applied to a running "
"session: it takes effect at the next one."
msgstr "Usa in automatico il pool degli endpoint segnati come paralleli; sequenziale ignora ogni interruttore per livello e percorre i livelli in ordine. Non vale a caldo: ha effetto dalla sessione successiva."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:616
msgid "Auto (parallel if any level is marked)"
msgstr "Automatico (parallelo se un livello è segnato)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:616
msgid "Sequential (one level at a time)"
msgstr "Sequenziale (un livello alla volta)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:624
msgid "Current dispatch"
msgstr "Dispatch attuale"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:652
msgid "Paste channel"
msgstr "Canale di inserimento"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:653
msgid "Choose clipboard insertion or simulated keystrokes."
msgstr "Scegli l'inserimento dagli appunti o tramite tasti simulati."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:654
msgid "Clipboard"
msgstr "Appunti"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:654
msgid "Keystrokes"
msgstr "Tasti simulati"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:658
msgid "Paste shortcut"
msgstr "Scorciatoia di incolla"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:659
msgid "Use Ctrl+Shift+V for terminals/TUIs such as opencode."
msgstr "Usa Ctrl+Shift+V per terminali/TUI come opencode."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:678
msgid "Paste delay (ms)"
msgstr "Ritardo di incolla (ms)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:679
msgid "Pause before pasting to ensure clipboard is ready (default 250 ms)"
msgstr ""
"Pausa prima di incollare per garantire che gli appunti siano pronti (default "
"250 ms)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:691
msgid "Chunk segmentation (per-chunk mode only)"
msgstr "Segmentazione per chunk (solo modalità per chunk)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:692
msgid "Fine-tune how pauses in speech are detected to split chunks."
msgstr "Regola come rilevare le pause nel parlato per dividere i chunk."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:697
msgid "Silence duration (seconds)"
msgstr "Durata del silenzio (secondi)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:698
msgid "Length of silence that triggers transcription of the current chunk"
msgstr "Durata del silenzio che avvia la trascrizione del chunk corrente"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:711
msgid "Silence noise threshold (dB)"
msgstr "Soglia rumore del silenzio (dB)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:712
msgid "Audio level below which sound is considered silence (e.g. -30 dB)"
msgstr ""
"Livello audio sotto il quale il suono è considerato silenzio (es. -30 dB)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:724
msgid "Adaptive VAD margin (dB)"
msgstr "Margine VAD adattivo (dB)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:725
msgid ""
"How far above the measured adaptive noise floor speech must be to count as "
"voice. Distinct from the initial silence threshold above; the VAD re-"
"estimates the floor while listening."
msgstr ""
"Quanto sopra il noise floor adattivo misurato deve stare la voce per essere "
"considerata tale. Distinto dalla soglia di silenzio iniziale qui sopra; il "
"VAD stima di nuovo il floor durante l'ascolto."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:738
msgid "Min utterance (seconds)"
msgstr "Enunciato minimo (secondi)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:739
msgid "Shorter audio fragments are discarded as noise"
msgstr "I frammenti audio più brevi vengono scartati come rumore"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:752
msgid "Max utterance (seconds)"
msgstr "Enunciato massimo (secondi)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:753
msgid "Forces chunk transcription if you speak continuously without pauses"
msgstr "Forza la trascrizione del chunk se si parla continuamente senza pause"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:766
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1377
msgid "Language"
msgstr "Lingua"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:767
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1378
msgid "ISO 639-1 language code for transcription (e.g. \"it\" for Italian)"
msgstr ""
"Codice lingua ISO 639-1 per la trascrizione (es. \"it\" per l'italiano)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:777
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1412
msgid "Initial prompt"
msgstr "Prompt iniziale"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:778
msgid "Optional prompt to guide the transcription (context for Whisper)"
msgstr "Prompt opzionale per guidare la trascrizione (contesto per Whisper)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:788
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1395
msgid "Hotwords"
msgstr "Parole chiave"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:789
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1396
msgid "Bias transcription toward these words (space-separated)"
msgstr "Biases la trascrizione verso queste parole (separate da spazi)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:799
msgid "Context"
msgstr "Contesto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:800
msgid "Append the last 3 transcribed chunks to the prompt for better context"
msgstr ""
"Aggiunge gli ultimi 3 chunk trascritti al prompt per migliorare il contesto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:810
msgid "Voice commands"
msgstr "Comandi vocali"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:811
msgid "Exact spoken keywords can press a key or delete the last word/chunk."
msgstr ""
"Le parole chiave esatte possono premere un tasto o eliminare l'ultima parola/"
"porzione."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:816
msgid "Command validation failed"
msgstr "Validazione del comando non riuscita"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:816
msgid "Check that keywords are unique and command settings are valid."
msgstr ""
"Verificare che le parole chiave siano univoche e le impostazioni valide."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:840
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1003
msgid "Command keyword"
msgstr "Parola chiave del comando"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:848
msgid "Remove"
msgstr "Rimuovi"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:853
msgid "Keyword"
msgstr "Parola chiave"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:857
msgid "Aliases / Alternative phrases"
msgstr "Alias / Frasi alternative"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:859
msgid "Comma-separated equivalent phrases that trigger this command."
msgstr "Frasi equivalenti separate da virgole che attivano questo comando."

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:863
msgid "Action"
msgstr "Azione"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:865
msgid "Press key"
msgstr "Premi tasto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:865
msgid "Delete text"
msgstr "Elimina testo"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:870
msgid "Key (e.g. Return)"
msgstr "Tasto (es. Return)"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:884
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:911
msgid "Record key"
msgstr "Registra tasto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:890
#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:1322
msgid "Cancel"
msgstr "Annulla"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:933
msgid "Press a key…"
msgstr "Premi un tasto…"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:954
msgid "Modifier combinations are not supported; press a single key"
msgstr ""
"Le combinazioni di modificatori non sono supportate; premi un singolo tasto"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:960
msgid "Key not supported for voice commands"
msgstr "Tasto non supportato per i comandi vocali"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:972
msgid "word or chunk"
msgstr "parola o porzione"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:973
msgid "Single word"
msgstr "Una parola"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:973
msgid "Whole chunk"
msgstr "Intera porzione"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js:978
