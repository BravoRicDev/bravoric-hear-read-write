msgid "Start dictation"
msgstr "Avvia la dettatura"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js
msgid "Stop dictation"
msgstr "Ferma la dettatura"

#: gnome-extension/bravoric-hear-read-write@riccardomurru.it/prefs.js
